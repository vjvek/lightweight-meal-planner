{
    "compilerOptions": {
        "target": "esnext",
        "lib": ["esnext", "dom", "dom.iterable"],
        "module": "esnext",
        "types": ["jquery", "datatables.net", "bootstrap", "select2", "sortablejs"],
        "strict": true,
        "skipLibCheck": false,
        "verbatimModuleSyntax": true,
        "allowSyntheticDefaultImports": true,
        "moduleDetection": "force",
        "noUncheckedIndexedAccess": true,
        "rootDir": "public/src",
        "outDir": "public/dist"
    }
}